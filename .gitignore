# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data / logs / artifacts — anchored to the repo root: unanchored `data/`
# and `config/` also match src/cocoon/data/ and src/cocoon/core/config/,
# which silently excluded those packages from version control.
/data/
/logs/
/mlruns/
/mlflow.db
/mlflow.db/
/config/

# MQL5 build artifacts
*.ex5

# OS / editor cruft
.DS_Store
.idea/
.vscode/
