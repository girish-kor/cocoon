# Cocoon environment template — copy to `.env` and fill in real values.
# `.env` is git-ignored; this template is safe to commit.
#
# Env vars use the COCOON_ prefix and "__" to nest config paths.
# Precedence (highest wins): CLI flag > env var > profile file > base.yaml.

# --- MT5 credentials ---
COCOON_MT5__LOGIN=00000000
COCOON_MT5__PASSWORD=
COCOON_MT5__SERVER=

# --- MT5 connection (optional; defaults in config/base.yaml) ---
# COCOON_MT5__TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# COCOON_MT5__ZMQ_REQ_PORT=5555
# COCOON_MT5__ZMQ_PUB_PORT=5556

# --- Runtime (optional) ---
# COCOON_RUNTIME__MODE=paper
# COCOON_RUNTIME__LOG_LEVEL=INFO
